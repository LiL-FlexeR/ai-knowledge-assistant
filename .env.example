# Root .env is explicitly loaded by API/web dev and start commands.
# Shell variables take precedence. Liveness boots with this file absent.
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
# STORAGE_ROOT must be absolute if set; default is <repo>/.local/documents.
STORAGE_ROOT=

# Local-only credentials. Generate separate URL-safe values (e.g. random hex).
# Compose refuses to start without these. Never commit the private root .env.
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
DB_PORT=5432
# Host URLs: insert the matching passwords above; percent-encode URL characters.
# DATABASE_URL=postgresql://aka_runtime:<runtime-password>@127.0.0.1:5432/aka
# MIGRATION_DATABASE_URL=postgresql://aka_migrator:<migration-password>@127.0.0.1:5432/aka
# Compose supplies db:5432 URLs internally. Migration URL never enters the API.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Harness generates its own test URL/storage; leave these blank.
TEST_DATABASE_URL=
# Optional for migrate:dev only; use a separately owned empty development DB.
SHADOW_DATABASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROFILE_ID=openai-small-1536-v1
PIPELINE_VERSION=v1
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_EXTRACTED_CHARS=500000
MAX_DOCUMENT_TOKENS=100000
MAX_CHUNKS=256
MAX_DOCUMENTS=100
MAX_STORED_BYTES=209715200
MAX_PENDING_DOCUMENTS=5
INGESTION_CONCURRENCY=1
INGESTION_POLL_MS=1000
CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.30
CONTEXT_MAX_TOKENS=4000
ANSWER_MAX_OUTPUT_TOKENS=800
QUESTION_MAX_CHARS=2000
QUESTION_MAX_TOKENS=512
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
INGESTION_TIMEOUT_MS=180000
ASK_TIMEOUT_MS=65000
EXTRACTION_TIMEOUT_MS=15000
EXTRACTION_MAX_MEMORY_MB=256
AI_MAX_CONCURRENT_REQUESTS=2
