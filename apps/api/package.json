{
  "name": "@aka/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && concurrently --kill-others --success first --names compile,http \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node ../../scripts/with-env.mjs node --watch dist/main.js\"",
    "start": "node ../../scripts/with-env.mjs node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@aka/shared": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "busboy": "1.6.0",
    "js-tiktoken": "1.0.21",
    "openai": "7.57.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15"
  }
}
